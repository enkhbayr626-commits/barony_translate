# Payload checksums describe exact bytes. Never normalize game files on checkout
# or in GitHub's source ZIP (Windows text assets may contain CRLF).
Barony-Mongolian/** -text whitespace=-blank-at-eol
# Spaces in translation fragments are intentional when the game joins strings.
manual/*.tsv -text whitespace=-blank-at-eol
*.ttf binary
*.png binary
*.ps1 text eol=crlf
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
# More-specific override after the JSON rule.
Barony-Mongolian/** -text
